    {
      "@type": "FAQPage",
      "@id": "https://eliavatravel.com/services/#faq",
      "url": "https://eliavatravel.com/services/",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Which package should I start with?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Take the 1-minute check. Or pick Not sure yet on the form, and our experts will help you choose on your free call."
          }
        },
        {
          "@type": "Question",
          "name": "Do you work in my tools?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. Tern, TravelJoy, Travefy, Trello, or even a spreadsheet. If you have no system yet, we'll help you pick one."
          }
        },
        {
          "@type": "Question",
          "name": "How do you get into my tools?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "You add us as a user in your tool, and you can remove us anytime. Your host login is never needed. Passwords go through a password manager, never email."
          }
        },
        {
          "@type": "Question",
          "name": "Who talks to my clients?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "You do. Eliava never contacts your clients on its own, markets to them or books them. Anything that goes to a client goes out in your name, after your OK."
          }
        },
        {
          "@type": "Question",
          "name": "What happens on the free call?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "We talk through what's piling up and what you need. It's free and takes 25 minutes on Zoom. After that, your plan and price come in writing, and updates come by email."
          }
        },
        {
          "@type": "Question",
          "name": "Can I cancel weekly help?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. Month-to-month plans can stop at the end of any month. On the quarter plan, you agree to those first 3 months. Month 1 is $1,100 with no commitment, and if you pick the quarter plan by day 25, $110 comes off month 2. On Embedded, that's $220."
          }
        },
        {
          "@type": "Question",
          "name": "Are you US-based?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. Eliava is based in Georgia and works US business hours."
          }
        },
        {
          "@type": "Question",
          "name": "My business is complex. Can you still help?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. We plan it together on your free call, and you get a written quote first."
          }
        }
      ]
    }
  ]
}
